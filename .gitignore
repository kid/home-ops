.env

# Devenv
.devenv
.direnv
.worktrees
.pre-commit-config.yaml

# Terragrunt
.terragrunt-cache
.terragrunt-stack

# OpenTofu/Terraform
.terraform
*.tfstate
*.tfstate.backup
*.tfstate.lock.info

# Talos / Kubernetes
talosconfig
kubeconfig

.agents/

# secrets/clusters/ holds only committed .pub keys and .sops/.sops.*
# ciphertext — a safety net against a stray manual decrypt getting added.
/secrets/clusters/*/**
!/secrets/clusters/*/**/
!/secrets/clusters/*/**/*.pub
!/secrets/clusters/*/**/*.sops
!/secrets/clusters/*/**/*.sops.*
