.env

# Devenv
.devenv
.direnv
.worktrees
.pre-commit-config.yaml

# Nix
result

# Terragrunt
.terragrunt-cache
.terragrunt-stack

# OpenTofu/Terraform
.terraform
# tofunix's CLI copies it next to a tofu stack; its providers are pinned in Nix.
/tf-stacks/*/k3s/.terraform.lock.hcl
*.tfstate
*.tfstate.backup
*.tfstate.lock.info

# Talos / Kubernetes
talosconfig
kubeconfig

.agents/
.claude/

# secrets/clusters/ holds only committed .pub keys and .sops/.sops.*
# ciphertext — a safety net against a stray manual decrypt getting added.
/secrets/clusters/*/**
!/secrets/clusters/*/**/
!/secrets/clusters/*/**/*.pub
!/secrets/clusters/*/**/*.sops
!/secrets/clusters/*/**/*.sops.*
