// Base config (presets, the `# renovate:` comment manager, the Nix hash
// refresh) is .renovate/org-inherited-config.json5, inherited by every repo
// the renovate-operator of modules/aspects/kubernetes/renovate runs.
{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  ignorePaths: [
    '**/resources/**',
    // nixidy-generated, regenerated from modules/aspects/kubernetes/**/*.nix via `nix run .#write-flake`
    'manifests/**',
  ],
  // A jump over several majors becomes one PR per major, so each step's
  // breaking changes land (and get reviewed) on their own.
  separateMultipleMajor: true,
  // A merge is a prd deploy (Flux), and `checks` only proves the change
  // renders and builds: auto-merges (packageRules below) land in daytime,
  // when someone is around to notice a broken deploy. Renovate merges itself
  // on its 3-hourly run, since GitHub's native auto-merge, enabled at PR
  // creation, ignores automergeSchedule. The presets' :automergeBranch would
  // push to main, which the ruleset rejects: every change goes through a PR.
  automergeType: "pr",
  platformAutomerge: false,
  automergeSchedule: ["* 8-17 * * *"],
  flux: {
    managerFilePatterns: ["/\\.yaml(?:\\.j2)?$/"],
  },
  "helm-values": {
    managerFilePatterns: ["/\\.yaml(?:\\.j2)?$/"],
  },
  kubernetes: {
    managerFilePatterns: ["/\\.yaml(?:\\.j2)?$/"],
  },
  customManagers: [
    // charts/<org>/<chart>/default.nix pins (see charts/README.md): a plain
    // helm repo, or an oci:// one which Renovate reads as a docker image.
    {
      customType: "regex",
      managerFilePatterns: ["/^charts/.+/default\\.nix$/"],
      matchStrings: [
        "repo = \"(?<registryUrl>https?://[^\"]+)\";\\s*chart = \"(?<depName>[^\"]+)\";\\s*version = \"(?<currentValue>[^\"]+)\";",
      ],
      datasourceTemplate: "helm",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^charts/.+/default\\.nix$/"],
      matchStrings: [
        "repo = \"oci://(?<registry>[^\"]+)\";\\s*chart = \"(?<chart>[^\"]+)\";\\s*version = \"(?<currentValue>[^\"]+)\";",
      ],
      datasourceTemplate: "docker",
      depNameTemplate: "{{{registry}}}/{{{chart}}}",
    },
    // Flake inputs on the manifest path (nixidy, nix-kube-generators) are
    // pinned by rev in the module that declares them, so each
    // gets its own PR. The nix manager would edit the generated flake.nix
    // instead, which flake-file then reports as drift.
    {
      customType: "regex",
      managerFilePatterns: ["/^modules/.+\\.nix$/"],
      matchStrings: [
        "\"github:(?<depName>[^/\"]+/[^/\"]+)/(?<currentDigest>[0-9a-f]{40})\"",
      ],
      datasourceTemplate: "git-refs",
      packageNameTemplate: "https://github.com/{{{depName}}}",
    },
  ],
  customDatasources: {
    // Build list of the ksa-archive.net mirror that
    // pkgs/kitten-space-agency fetches from. Only builds named
    // ksa_linux_v<version>.tar.gz match the package's URL template; older
    // Linux builds used other names.
    "kitten-space-agency": {
      defaultRegistryUrlTemplate: "https://ksa-archive.net/builds.json",
      transformTemplates: [
        '{"releases": $[$contains(linuxFile, /^ksa_linux_v[0-9.]+\\.tar\\.gz$/)].{"version": $match(linuxFile, /v([0-9.]+)\\.tar\\.gz$/).groups[0], "releaseTimestamp": date}}',
      ],
    },
    // The Kanidm release kaniop's latest release is built against: the
    // kanidm_client crate in its Cargo.toml. jsDelivr's @latest resolves to
    // the newest release tag (kaniop's master can carry a bump that a release
    // never ships), cached up to 12h behind it.
    "kaniop-kanidm": {
      defaultRegistryUrlTemplate: "https://cdn.jsdelivr.net/gh/pando85/kaniop@latest/Cargo.toml",
      format: "toml",
      transformTemplates: [
        '($c := workspace.dependencies.kanidm_client; {"releases": [{"version": $type($c) = "string" ? $c : $c.version}], "sourceUrl": "https://github.com/kanidm/kanidm", "homepage": "https://kanidm.com"})',
      ],
    },
  },
  packageRules: [
    {
      matchManagers: ["nix"],
      enabled: true,
    },
    {
      // A nixpkgs bump changes the Renovate image, and with it the
      // RenovateJob's image tag (modules/aspects/kubernetes/renovate).
      matchManagers: ["nix"],
      matchUpdateTypes: ["lockFileMaintenance"],
      semanticCommitScope: "nix",
      postUpgradeTasks: {
        commands: ["nix run .#write-flake"],
        fileFilters: ["manifests/**"],
        executionMode: "update",
      },
    },
    {
      // The chart and the CRD source pin (cilium/network-policy.nix) share a
      // version, so bump them in one PR.
      matchDatasources: ["helm", "github-releases"],
      matchDepNames: ["cilium", "cilium/cilium"],
      groupName: "cilium",
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
    },
    {
      // The Flux controllers' CRD source pins (nixidy-defaults.nix,
      // flux/webhook.nix) come out of one Flux release, so bump them in one
      // PR. The running controllers follow the flux-operator chart instead.
      matchDatasources: ["github-releases"],
      matchDepNames: ["fluxcd/*"],
      groupName: "fluxcd",
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
    },
    {
      // Kanidm follows kaniop (custom.kaniop-kanidm above), so both land in
      // one PR. kaniop releases step Kanidm one minor at a time, the only
      // upgrade Kanidm supports.
      matchDatasources: ["docker", "custom.kaniop-kanidm"],
      matchDepNames: [
        "docker.io/kanidm/server",
        "ghcr.io/pando85/helm-charts/kaniop",
      ],
      groupName: "kanidm",
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
    },
    {
      // The OCI chart carries no source annotation, so without this the PR
      // has no release notes.
      matchDatasources: ["docker"],
      matchDepNames: ["ghcr.io/pando85/helm-charts/kaniop"],
      sourceUrl: "https://github.com/pando85/kaniop",
    },
    {
      // Moves every input not pinned by rev (nixpkgs, the other flake
      // inputs, transitive ones) together in the weekly lockFileMaintenance
      // PR. Manifests must not change with it, the Renovate image's tag
      // excepted: pin anything a chart derives from Helm's own version (e.g.
      // .Capabilities.KubeVersion) in the chart values instead.
      matchManagers: ["nix"],
      matchUpdateTypes: ["major", "minor", "patch", "digest", "pin", "pinDigest", "bump"],
      enabled: false,
    },
    {
      // Skips the lookup of FlakeHub tarball inputs: the nix manager looks
      // them up as git-refs on the flakehub.com URL, which is no git repo, so
      // each run reports a lookup failure. Updates are disabled above anyway.
      // Matches packageName only, so lockFileMaintenance stays enabled.
      matchManagers: ["nix"],
      matchPackageNames: ["https://flakehub.com/**"],
      enabled: false,
    },
    {
      // flake.nix and flake.lock are regenerated from the bumped module.
      matchManagers: ["custom.regex"],
      matchDatasources: ["git-refs"],
      postUpgradeTasks: {
        commands: ["nix run .#write-flake", "nix flake lock"],
        fileFilters: ["flake.nix", "flake.lock"],
        executionMode: "update",
      },
    },
    {
      // Every other pin in Nix: rehash it, then regenerate manifests/ and the
      // tofu stacks so the PR passes checks.manifests and checks.tofu.
      // rehash-changed-pins rehashes every bumped pin, not just this
      // update's: Renovate applies a group's bumps at once, so a sibling's
      // stale hash would fail this update's write-flake. Replaces the
      // inherited refresh-nix-hash, which only knows its own pin.
      matchManagers: ["custom.regex"],
      matchDatasources: ["docker", "helm", "github-releases", "custom.kaniop-kanidm", "terraform-provider"],
      postUpgradeTasks: {
        commands: [
          "nix run .#rehash-changed-pins",
          "nix run .#write-flake",
        ],
        fileFilters: ["**/*.nix", "manifests/**", "tf-stacks/**/main.tf.json"],
        executionMode: "update",
      },
    },
    {
      // Auto-merge patch and digest updates once the release is 3 days old,
      // so a yanked or quickly re-patched one never lands. timestamp-optional:
      // an update with no release timestamp merges without the wait, with a
      // warning, instead of never (the known ones skip the wait below).
      matchUpdateTypes: ["patch", "digest"],
      automerge: true,
      minimumReleaseAge: "3 days",
      minimumReleaseAgeBehaviour: "timestamp-optional",
    },
    {
      matchManagers: ["github-actions"],
      matchUpdateTypes: ["minor"],
      automerge: true,
      minimumReleaseAge: "3 days",
      minimumReleaseAgeBehaviour: "timestamp-optional",
    },
    {
      // The *arr apps also take minors unattended.
      matchDatasources: ["docker"],
      matchDepNames: [
        "ghcr.io/home-operations/sonarr",
        "ghcr.io/home-operations/radarr",
        "ghcr.io/home-operations/prowlarr",
        "ghcr.io/home-operations/sabnzbd",
        "ghcr.io/recyclarr/recyclarr",
        "ghcr.io/unpackerr/unpackerr",
      ],
      matchUpdateTypes: ["minor"],
      automerge: true,
      minimumReleaseAge: "3 days",
      minimumReleaseAgeBehaviour: "timestamp-optional",
    },
    {
      // No release timestamp to age against: git-refs digests (the flake
      // inputs pinned by rev in modules/, and the nix manager's, whose updates
      // are disabled above) and ghcr.io OCI charts (no created date in a Helm
      // chart's config). Without this each run warns about them.
      matchDatasources: ["git-refs"],
      minimumReleaseAge: null,
    },
    {
      matchFileNames: ["charts/**"],
      matchDepNames: ["ghcr.io/**"],
      minimumReleaseAge: null,
    },
    {
      // Never unattended: Home Assistant and its stack, and Kanidm, which
      // only upgrades one minor at a time and gates every login.
      matchFileNames: ["modules/aspects/kubernetes/home-assistant/**"],
      automerge: false,
    },
    {
      matchDepNames: [
        "docker.io/kanidm/server",
        "ghcr.io/pando85/helm-charts/kaniop",
      ],
      automerge: false,
    },
    {
      // Labels every update by whether the rules above leave it
      // auto-merging, so the PRs to merge by hand filter on `no-automerge`.
      // Must stay last: matchJsonata sees the config earlier rules built,
      // and `automerge` is no template variable, so a templated label can't
      // do it. A group gets a label if any member has it, but auto-merges
      // only when all do: a mixed group carries both labels and waits for a
      // hand merge, so `no-automerge` stays exact where `automerge` is not.
      matchJsonata: ["automerge = true"],
      addLabels: ["automerge"],
    },
    {
      // $not: an unset automerge compares false against anything.
      matchJsonata: ["$not(automerge = true)"],
      addLabels: ["no-automerge"],
    },
  ],
}
