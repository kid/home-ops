{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    'docker:enableMajor',
    'helpers:pinGitHubActionDigests',
    'github>kid/home-ops//.renovate/groups.json5',
    'github>kid/home-ops//.renovate/labels.json5',
    'github>kid/home-ops//.renovate/overrides.json5',
    'github>kid/home-ops//.renovate/semanticCommits.json5',
    ':automergeBranch',
    ':disableRateLimiting',
    ':dependencyDashboard',
    ':semanticCommits',
    ':timezone(Europe/Brussels)',
  ],
  ignorePaths: [
    '**/resources/**',
    'manifests/**',
  ],
  suppressNotifications: [
    'prEditedNotification',
    'prIgnoreNotification',
  ],
  gitIgnoredAuthors: [
    '29139614+renovate[bot]@users.noreply.github.com',
  ],
  flux: {
    managerFilePatterns: [
      '/\\.yaml(?:\\.j2)?$/',
    ],
  },
  'helm-values': {
    managerFilePatterns: [
      '/\\.yaml(?:\\.j2)?$/',
    ],
  },
  kubernetes: {
    managerFilePatterns: [
      '/\\.yaml(?:\\.j2)?$/',
    ],
  },
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '/.*\\.nix$/',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>[a-z-]+?)(?: depName=(?<depName>.+?))?\\s+\\S+\\s*=\\s*"(?<currentValue>[^"]+)";',
      ],
    },
  ],
  nix: {
    enabled: true,
  },
  packageRules: [
    {
      matchManagers: [
        'nix',
      ],
      enabled: true,
    },
    {
      matchManagers: [
        'nix',
      ],
      matchDepNames: [
        'nixhelm',
      ],
      enabled: true,
    },
    {
      matchManagers: [
        'custom.regex',
      ],
      matchDatasources: [
        'github-releases',
      ],
      postUpgradeTasks: {
        commands: [
          'nix run .#refresh-nix-hash -- {{{packageFile}}} {{{depName}}} {{{newValue}}}',
        ],
        fileFilters: [
          '**/*.nix',
        ],
        executionMode: 'update',
      },
    },
  ],
}
