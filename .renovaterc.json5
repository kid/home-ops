{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    "config:recommended",
    "docker:enableMajor",
    "helpers:pinGitHubActionDigests",
    "github>kid/home-ops//.renovate/groups.json5",
    "github>kid/home-ops//.renovate/labels.json5",
    "github>kid/home-ops//.renovate/overrides.json5",
    "github>kid/home-ops//.renovate/semanticCommits.json5",
    ":automergeBranch",
    ":disableRateLimiting",
    ":dependencyDashboard",
    ":semanticCommits",
    ":timezone(Europe/Brussels)",
  ],
  ignorePaths: [
    '**/resources/**',
    // nixidy-generated, regenerated from modules/kubernetes/**/*.nix via `nix run .#write-manifests`
    'manifests/**',
  ],
  suppressNotifications: [
    "prEditedNotification",
    "prIgnoreNotification",
  ],
  // Adopt the PRs the hosted Renovate GitHub App opened before this repo
  // self-hosted: without this the self-hosted run reads the App's commits as
  // manual edits and never updates them. Its other half, ignorePrAuthor, is
  // global-only (RENOVATE_IGNORE_PR_AUTHOR in .github/workflows/renovate.yaml).
  // Keep both while any of those PRs is still open.
  gitIgnoredAuthors: ["29139614+renovate[bot]@users.noreply.github.com"],
  flux: {
    managerFilePatterns: ["/\\.yaml(?:\\.j2)?$/"],
  },
  "helm-values": {
    managerFilePatterns: ["/\\.yaml(?:\\.j2)?$/"],
  },
  kubernetes: {
    managerFilePatterns: ["/\\.yaml(?:\\.j2)?$/"],
  },
  customManagers: [
    {
      customType: "regex",
      managerFilePatterns: ["/.*\\.nix$/"],
      matchStrings: [
        "# renovate: datasource=(?<datasource>[a-z-]+?)(?: depName=(?<depName>.+?))?\\s+\\S+\\s*=\\s*\"(?<currentValue>[^\"]+)\";",
      ],
    },
    // charts/<org>/<chart>/default.nix pins (see charts/README.md): a plain
    // helm repo, or an oci:// one which Renovate reads as a docker image.
    {
      customType: "regex",
      managerFilePatterns: ["/^charts/.+/default\\.nix$/"],
      matchStrings: [
        "repo = \"(?<registryUrl>https?://[^\"]+)\";\\s*chart = \"(?<depName>[^\"]+)\";\\s*version = \"(?<currentValue>[^\"]+)\";",
      ],
      datasourceTemplate: "helm",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^charts/.+/default\\.nix$/"],
      matchStrings: [
        "repo = \"oci://(?<registry>[^\"]+)\";\\s*chart = \"(?<chart>[^\"]+)\";\\s*version = \"(?<currentValue>[^\"]+)\";",
      ],
      datasourceTemplate: "docker",
      depNameTemplate: "{{{registry}}}/{{{chart}}}",
    },
  ],
  nix: {
    enabled: true,
  },
  packageRules: [
    {
      matchManagers: ["nix"],
      enabled: true,
    },
    {
      matchManagers: ["nix"],
      matchDepNames: ["nixhelm"],
      enabled: true,
    },
    {
      // Every pin has a content hash next to its version, which Renovate
      // cannot recompute: left stale, Nix silently keeps serving the old
      // content. Recompute it, then regenerate manifests/ so the PR passes
      // checks.manifests.
      matchManagers: ["custom.regex"],
      matchDatasources: ["github-releases"],
      postUpgradeTasks: {
        commands: [
          "nix run .#refresh-nix-hash -- {{{packageFile}}} {{{depName}}} {{{newValue}}}",
          "nix run .#write-manifests -- --skip-secrets",
        ],
        fileFilters: ["**/*.nix", "manifests/**"],
        executionMode: "update",
      },
    },
    {
      matchManagers: ["custom.regex"],
      matchFileNames: ["charts/**"],
      postUpgradeTasks: {
        commands: [
          "nix run .#refresh-nix-hash -- {{{packageFile}}} {{{depName}}} {{{newValue}}}",
          "nix run .#write-manifests -- --skip-secrets",
        ],
        fileFilters: ["**/*.nix", "manifests/**"],
        executionMode: "update",
      },
    },
  ],
}
