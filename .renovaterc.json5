// Base config (presets, the `# renovate:` comment manager, the Nix hash
// refresh) is inherited from kid/renovate-config, which also runs Renovate.
{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  ignorePaths: [
    '**/resources/**',
    // nixidy-generated, regenerated from modules/kubernetes/**/*.nix via `nix run .#write-manifests`
    'manifests/**',
  ],
  flux: {
    managerFilePatterns: ["/\\.yaml(?:\\.j2)?$/"],
  },
  "helm-values": {
    managerFilePatterns: ["/\\.yaml(?:\\.j2)?$/"],
  },
  kubernetes: {
    managerFilePatterns: ["/\\.yaml(?:\\.j2)?$/"],
  },
  customManagers: [
    // charts/<org>/<chart>/default.nix pins (see charts/README.md): a plain
    // helm repo, or an oci:// one which Renovate reads as a docker image.
    {
      customType: "regex",
      managerFilePatterns: ["/^charts/.+/default\\.nix$/"],
      matchStrings: [
        "repo = \"(?<registryUrl>https?://[^\"]+)\";\\s*chart = \"(?<depName>[^\"]+)\";\\s*version = \"(?<currentValue>[^\"]+)\";",
      ],
      datasourceTemplate: "helm",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^charts/.+/default\\.nix$/"],
      matchStrings: [
        "repo = \"oci://(?<registry>[^\"]+)\";\\s*chart = \"(?<chart>[^\"]+)\";\\s*version = \"(?<currentValue>[^\"]+)\";",
      ],
      datasourceTemplate: "docker",
      depNameTemplate: "{{{registry}}}/{{{chart}}}",
    },
    // Flake inputs on the manifest/chart path (nixidy, nix-kube-generators,
    // nixhelm) are pinned by rev in the module that declares them, so each
    // gets its own PR. The nix manager would edit the generated flake.nix
    // instead, which flake-file then reports as drift.
    {
      customType: "regex",
      managerFilePatterns: ["/^modules/.+\\.nix$/"],
      matchStrings: [
        "\"github:(?<depName>[^/\"]+/[^/\"]+)/(?<currentDigest>[0-9a-f]{40})\"",
      ],
      datasourceTemplate: "git-refs",
      packageNameTemplate: "https://github.com/{{{depName}}}",
    },
  ],
  packageRules: [
    {
      matchManagers: ["nix"],
      enabled: true,
    },
    {
      // Provider lock refreshes get their own PR, apart from flake.lock.
      matchManagers: ["terraform", "terragrunt"],
      matchUpdateTypes: ["lockFileMaintenance"],
      groupName: "terraform providers",
    },
    {
      // The chart and the CRD source pin (cilium/network-policy.nix) share a
      // version, so bump them in one PR.
      matchDatasources: ["helm", "github-releases"],
      matchDepNames: ["cilium", "cilium/cilium"],
      groupName: "cilium",
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
    },
    {
      matchManagers: ["nix"],
      matchDepNames: ["nixhelm"],
      enabled: true,
    },
    {
      // Moves every input not pinned by rev (nixpkgs, the other flake
      // inputs, transitive ones) together in the weekly lockFileMaintenance
      // PR. Manifests must not change with it: pin anything a chart derives
      // from Helm's own version (e.g. .Capabilities.KubeVersion) in the
      // chart values instead.
      matchManagers: ["nix"],
      matchUpdateTypes: ["major", "minor", "patch", "digest", "pin", "pinDigest", "bump"],
      enabled: false,
    },
    {
      // flake.nix and flake.lock are regenerated from the bumped module.
      matchManagers: ["custom.regex"],
      matchDatasources: ["git-refs"],
      postUpgradeTasks: {
        commands: ["nix run .#write-flake", "nix flake lock"],
        fileFilters: ["flake.nix", "flake.lock"],
        executionMode: "update",
      },
    },
    {
      // Image pins in chart values: regenerate manifests/ so the PR passes
      // checks.manifests.
      matchManagers: ["custom.regex"],
      matchDatasources: ["docker"],
      matchFileNames: ["modules/**"],
      postUpgradeTasks: {
        commands: ["nix run .#write-manifests -- --skip-secrets"],
        fileFilters: ["manifests/**"],
        executionMode: "update",
      },
    },
    {
      // Overrides the inherited hash refresh to also regenerate manifests/
      // so the PR passes checks.manifests.
      matchManagers: ["custom.regex"],
      matchDatasources: ["github-releases"],
      postUpgradeTasks: {
        commands: [
          "refresh-nix-hash {{{packageFile}}} {{{depName}}} {{{newValue}}}",
          "nix run .#write-manifests -- --skip-secrets",
        ],
        fileFilters: ["**/*.nix", "manifests/**"],
        executionMode: "update",
      },
    },
    {
      matchManagers: ["custom.regex"],
      matchFileNames: ["charts/**"],
      postUpgradeTasks: {
        commands: [
          "nix run .#rehash-chart -- {{{packageFile}}}",
          "nix run .#write-manifests -- --skip-secrets",
        ],
        fileFilters: ["**/*.nix", "manifests/**"],
        executionMode: "update",
      },
    },
  ],
}
