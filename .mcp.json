{
  "mcpServers": {
    "victoriametrics": {
      "command": "mcp-victoriametrics",
      "env": {
        "VM_INSTANCE_ENTRYPOINT": "https://metrics.kidibox.net",
        "VM_INSTANCE_TYPE": "single"
      }
    },
    "victorialogs": {
      "command": "mcp-victorialogs",
      "env": {
        "VL_INSTANCE_ENTRYPOINT": "https://logs.kidibox.net"
      }
    }
  }
}
