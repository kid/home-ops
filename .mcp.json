{
  "mcpServers": {
    "victoriametrics": {
      "type": "http",
      "url": "https://metrics.kidibox.net/mcp",
      "oauth": {
        "clientId": "mcp",
        "callbackPort": 33418,
        "scope": "openid profile email"
      }
    },
    "victorialogs": {
      "type": "http",
      "url": "https://logs.kidibox.net/mcp",
      "oauth": {
        "clientId": "mcp",
        "callbackPort": 33418,
        "scope": "openid profile email"
      }
    },
    "flux": {
      "type": "http",
      "url": "https://flux.kidibox.net/mcp",
      "oauth": {
        "clientId": "mcp",
        "callbackPort": 33418,
        "scope": "openid profile email"
      }
    },
    "home-assistant": {
      "type": "http",
      "url": "https://ha.kidibox.net/api/mcp",
      "headers": {
        "Authorization": "!t=$(op read 'op://home-ops/Home Assistant - mcp/token') && [ -n \"$t\" ] && printf 'Bearer %s' \"$t\""
      }
    }
  }
}
